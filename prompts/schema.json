      "type": "string"
    },
    "hooks": {
      "items": {
        "type": "string"
      },
      "title": "Hooks",
      "type": "array"
    },
    "why_viral": {
      "description": "Specific reason why this moment performs",
      "title": "Why Viral",
      "type": "string"
    },
    "category": {
      "default": "reaction",
      "enum": [
        "reaction",
        "funny",
        "fail",
        "clutch",
        "story",
        "rage",
        "wholesome",
        "news",
        "other"
      ],
      "title": "Category",
      "type": "string"
    },
    "signals": {
      "additionalProperties": true,
      "title": "Signals",
      "type": "object"
    },
    "risk_flags": {
      "items": {
        "type": "string"
      },
      "title": "Risk Flags",
      "type": "array"
